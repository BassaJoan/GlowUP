<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/zam"
                android:background="@drawable/bg_input"
                android:padding="4dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="User Avatar"/>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jane Doe"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvProfilePhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+256 700 123 456 | CLIENT"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnEditPersonalDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Personal Details &amp; Address"
                android:background="@drawable/bg_button_primary"
                android:textColor="@color/colorOnPrimary"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="48dp"/>

        </LinearLayout>

        <!-- Preferences & Favorites Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorites &amp; Wishlist"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSavedSalons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saved Salons &amp; Specialists (3) ›"
                android:background="@drawable/bg_input"
                android:textColor="@color/colorTextPrimary"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="48dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnReferralProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invite Friends &amp; Earn Discounts ›"
                android:background="@drawable/bg_input"
                android:textColor="@color/colorPrimary"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="48dp"/>

        </LinearLayout>

        <!-- Notifications & Support Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifications &amp; Support"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnNotificationSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminders &amp; Push Preferences ›"
                android:background="@drawable/bg_input"
                android:textColor="@color/colorTextPrimary"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="48dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnCustomerSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact Support / Refund Request ›"
                android:background="@drawable/bg_input"
                android:textColor="@color/colorError"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:minHeight="48dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
